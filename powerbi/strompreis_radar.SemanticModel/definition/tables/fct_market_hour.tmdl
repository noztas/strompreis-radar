	partition fct_market_hour = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs("dbc-a2cbda1f-cbb1.cloud.databricks.com", "/sql/1.0/warehouses/bc44dd4980fc6d10", [Catalog=null, Database=null, QueryTags=null, EnableAutomaticProxyDiscovery=null, Implementation=null]),
				    energy_Database = Source{[Name="energy",Kind="Database"]}[Data],
				    gold_Schema = energy_Database{[Name="gold",Kind="Schema"]}[Data],
				    fct_market_hour_Table = gold_Schema{[Name="fct_market_hour",Kind="Table"]}[Data]
				in
