table fct_market_hour
	lineageTag: 2237bc3f-2fe1-4057-aa2b-f1dbdd0dfa72

	/// Average day-ahead price per hour, for whatever is filtered (year, month, hour …)
	measure 'Avg Price (€/MWh)' = AVERAGE(fct_market_hour[price_eur_mwh])
		formatString: #,0.00
		displayFolder: KPIs
		lineageTag: ee9127d2-b2f8-4f58-ac79-5e3c80057110

	/// Hours with a price below 0 €/MWh (too much solar/wind, too little demand)
	measure 'Negative Price Hours' = CALCULATE(COUNTROWS(fct_market_hour), fct_market_hour[price_eur_mwh] < 0)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 725fd512-c2ba-4214-bd01-b7b9115d7831

	/// Solar + wind ÷ consumption. Add up first, then divide (never average a share).
	/// Only hours where both numbers exist, so early hours without consumption don't distort it.
	measure 'Renewable Share' =
			VAR complete_hours =
			    FILTER(
			        fct_market_hour,
			        NOT ISBLANK(fct_market_hour[renewable_mwh])
			            && NOT ISBLANK(fct_market_hour[consumption_mwh])
			    )
			RETURN
			    DIVIDE(
			        SUMX(complete_hours, fct_market_hour[renewable_mwh]),
			        SUMX(complete_hours, fct_market_hour[consumption_mwh])
			    )
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: da929d82-a61a-41f8-81a5-2b864258d52d

	/// What-if: cost of the NORMAL plan = N hours starting at 08:00, times MW. Only full days (>= 23 price hours), like mart_load_shift.
	measure 'Normal Cost (what-if) €' =
			VAR mw = [Machine MW Value]
			VAR n = [Flexible Hours Value]
			VAR full_days =
			    FILTER(
			        VALUES(fct_market_hour[date_day]),
			        CALCULATE(COUNT(fct_market_hour[price_eur_mwh])) >= 23
			    )
			RETURN
			    SUMX(
			        full_days,
			            VAR day_hours =
			                FILTER(CALCULATETABLE(fct_market_hour), NOT ISBLANK(fct_market_hour[price_eur_mwh]))
			            VAR normal_cost =
			                SUMX(
			                    FILTER(day_hours, fct_market_hour[hour_of_day] >= 8 && fct_market_hour[hour_of_day] < 8 + n),
			                    fct_market_hour[price_eur_mwh]
			                )
			            RETURN normal_cost * mw
			    )
		formatString: #,0
		displayFolder: What-if
		lineageTag: 94a34990-e62e-4a19-9476-3d2b368ee2b8

	/// What-if: money saved per day = (normal N hours - N cheapest hours) x MW, added up over all full days.
	/// TOPN = the N cheapest hours of the day (like row_number in mart_load_shift); ts_utc breaks ties.
	measure 'Saved (what-if) €' =
			VAR mw = [Machine MW Value]
			VAR n = [Flexible Hours Value]
			VAR full_days =
			    FILTER(
			        VALUES(fct_market_hour[date_day]),
			        CALCULATE(COUNT(fct_market_hour[price_eur_mwh])) >= 23
			    )
			RETURN
			    SUMX(
			        full_days,
			            VAR day_hours =
			                FILTER(CALCULATETABLE(fct_market_hour), NOT ISBLANK(fct_market_hour[price_eur_mwh]))
			            VAR normal_cost =
			                SUMX(
			                    FILTER(day_hours, fct_market_hour[hour_of_day] >= 8 && fct_market_hour[hour_of_day] < 8 + n),
			                    fct_market_hour[price_eur_mwh]
			                )
			            VAR cheap_cost =
			                SUMX(
			                    TOPN(n, day_hours, fct_market_hour[price_eur_mwh], ASC, fct_market_hour[ts_utc], ASC),
			                    fct_market_hour[price_eur_mwh]
			                )
			            RETURN (normal_cost - cheap_cost) * mw
			    )
		formatString: #,0
		displayFolder: What-if
		lineageTag: 13b0e70a-b555-423e-acbf-b1f58cd6c190

	/// What-if: saved / normal cost. SUM / SUM, never an average of daily percents.
	measure 'Saved % (what-if)' = DIVIDE([Saved (what-if) €], [Normal Cost (what-if) €])
		formatString: 0.0%
		displayFolder: What-if
		lineageTag: d41ae37a-8b91-4918-9e17-df635d1d2161

