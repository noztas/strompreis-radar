# Secrets – never upload!
.env

# Python
__pycache__/
*.pyc
.venv/

# dbt (generated files)
dbt/**/target/
dbt/**/logs/
dbt/**/dbt_packages/

# Data files (they live in Databricks, not in git)
*.json
!**/*.example.json

# Power BI project (PBIP): keep the report files (pages, visuals, theme are .json)
!powerbi/**/*.json
# ...but not the data cache and my personal settings (they stay on my PC)
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/localSettings.json

# Editor / system
.vscode/
.DS_Store
